---
import { copy, pathFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = copy(locale);
---

<div class="mx-auto min-h-svh max-w-2xl px-5 py-10">
  <a href={pathFor(locale)} class="text-sm text-gold hover:text-lemon">CharmDrop</a>
  <h1 class="mt-10 font-display text-4xl text-cream">{text.privacy.heading}</h1>
  <p class="mt-6 text-lg leading-relaxed text-cream-dim">{text.privacy.body}</p>
  <p class="mt-4 text-lg leading-relaxed text-cream-dim">{text.privacy.payment}</p>
</div>
